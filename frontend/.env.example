# Base URL of the ChainTrace backend API.
#
# Required whenever the frontend and backend are not served from the same
# origin, which includes every Vercel + Render setup. Vite inlines this at
# BUILD time: setting it in the hosting dashboard only takes effect on the
# next build.
#
# Leave it empty for local development — vite.config.js proxies /api to
# http://127.0.0.1:8000, and the Docker Compose deployment does the same
# through nginx.
#
# A deployed build with this unset sends API calls to its own domain. The app
# detects that and says so in a banner, and Settings -> Backend API Connection
# can point a running build at a backend without rebuilding it.
#
# VITE_API_URL=https://chaintrace-backend.onrender.com
